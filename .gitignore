# ---------------------------------------------------------------
data/raw/
data/processed/
data/uploads/
data/private/
backend/data/
*.xlsx
*.xls
*.csv
!data/sample/**/*.csv
!data/sample/**/*.xlsx
!backend/tests/fixtures/**/*.csv
!backend/tests/fixtures/**/*.xlsx

# Downloaded ML model caches
.cache/
hf_cache/

