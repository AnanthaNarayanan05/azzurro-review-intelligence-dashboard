# Azzurro Hotels – Review Intelligence Dashboard
# Backend configuration. Copy to `.env` in the repository root (never commit `.env`).
# Every value has a safe default; nothing here is required for local development.

# ---------------- Backend (FastAPI) ----------------
APP_ENV=development
# Empty = SQLite file at data/processed/azzurro.db. For hosted deployment use PostgreSQL, e.g.
# postgresql+psycopg://user:password@host:5432/azzurro
DATABASE_URL=
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000
# Upload limits
MAX_UPLOAD_MB=20
MAX_IMPORT_ROWS=100000
# Where a file is held between preview and commit (empty = data/uploads, git-ignored)
UPLOAD_DIR=
# Rating scale of incoming data (Booking.com review scores are out of 10)
DEFAULT_RATING_SCALE_MAX=10
# Minimum sample sizes before comparisons / trends are reported
MIN_SAMPLE_COMPARISON=30
MIN_SAMPLE_TREND_WINDOW=30

# ---------------- NLP ----------------
# vader | transformer   (final choice made after evaluation on the real data)
SENTIMENT_ENGINE=vader
TRANSFORMER_MODEL_NAME=

# ---------------- Optional LLM narrative layer ----------------
# none = deterministic, template-based insights only (default, free)
LLM_PROVIDER=none
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30

# ---------------- Frontend ----------------
# Frontend settings live in frontend/.env.example (Next.js reads env files from its own folder).
